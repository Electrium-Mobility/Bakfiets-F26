// find api references for these libraries
#include <SPI.h>
// what does this Wire object do? -> controls I2C communication https://docs.arduino.cc/language-reference/en/functions/communication/wire/
//#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ILI9341.h>
//#include <FastLED.h>

//****************************************************************************************************************

// #define is a preprocessor directive that basically acts like a const with no type checking (and no memory allocated)
#define SCREEN_WIDTH 240
#define SCREEN_HEIGHT 320

// FSPICS0
// chip select: for selecting which device to communicate with. low = chip is selected, high = chip unselected
#define CS 10

// FSPICLK
// clock signal generated by esp32 to synchronise data transfer
#define CLK 12

// FSPID
// ESP output, peripheral input
#define MOSI 11

// FSPIQ
// ESP input, peripheral output
#define MISO 13

// data/command pin (choose between data sending or command sending?)
#define DC 9

// reset
#define RST 8

// Instantiate new driver object (controls the screen)
Adafruit_ILI9341 screen = Adafruit_ILI9341(CS, DC, MOSI, CLK, RST, MISO);

//****************************************************************************************************************

void setup() {
  Serial.begin(9600);

  // initialize chip select pin(s) to high so no devices are competiting with each other
  pinMode(CS, OUTPUT);
  digitalWrite(CS, HIGH);

  // this starts the SPI communication
  screen.begin();
}

//****************************************************************************************************************

void loop() {

  // print text to screen
  Serial.println(testText());

  // wait 10s until redrawing
  delay(10000);

}

//****************************************************************************************************************

unsigned long testText() {

  // fill the screen with a colour
  screen.fillScreen(ILI9341_BLUE);

  // record start time (used for seeing how long the function takes to complete)
  unsigned long start = micros();

  screen.setCursor(0, 0);
  screen.setTextColor(ILI9341_WHITE);  screen.setTextSize(1);
  screen.println("Hello World!");
  screen.setTextColor(ILI9341_YELLOW); screen.setTextSize(2);
  screen.println(1234.56);
  screen.setTextColor(ILI9341_RED);    screen.setTextSize(3);
  screen.println(0xDEADBEEF, HEX);
  screen.println();
  screen.setTextColor(ILI9341_GREEN);
  screen.setTextSize(5);
  screen.println("Groop");
  screen.setTextSize(2);
  screen.println("I implore thee,");
  screen.setTextSize(1);
  screen.println("my foonting turlingdromes.");
  screen.println("And hooptiously drangle me");
  screen.println("with crinkly bindlewurdles,");
  screen.println("Or I will rend thee");
  screen.println("in the gobberwarts");
  screen.println("with my blurglecruncheon,");
  screen.println("see if I don't!");

  // return the duration of the command
  return micros() - start;
}

