/**************************************************************************
  Electrium Mobility Bakfiets display
  ILI9341 240x320 SPI TFT on an ESP32-S3, using the hardware SPI peripheral,
  plus left/right turn signal LEDs.
  Board: ESP32-S3 (Tools > Board > ESP32S3 Dev Module).

  Contributors: Patrick He, Kimberley Hoang, Alisa Wu, Saptarshi Bhattacherya,
                David Ertel, Youji Li [INSERT NAMES HERE]
 **************************************************************************/

#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ILI9341.h>

//****************************************************************************************************************
// DISPLAY: pins and settings
//****************************************************************************************************************

// Pins are the ESP32-S3's default FSPI (SPI2) pins, so the SPI hardware can drive them directly

// FSPICS0
// chip select: low = screen selected, high = screen ignores the SPI lines
#define CS 10

// FSPICLK
// clock signal generated by the SPI peripheral to synchronise data transfer
#define CLK 12

// FSPID
// ESP output, peripheral input
#define MOSI 11

// FSPIQ
// ESP input, peripheral output (not needed for drawing, only for reading from the screen)
#define MISO 13

// data/command pin: low = the bytes are a command, high = the bytes are pixel data
#define DC 9

// reset
#define RST 8

#define SCREEN_WIDTH 240
#define SCREEN_HEIGHT 320

// SPI clock speed for the screen. Lower it (20 or 10 MHz) if pixels look garbled on real hardware
#define SPI_FREQ 40000000

// How often the screen is redrawn
#define DISPLAY_MS 200  // 5 times per second

// Instantiate new driver object (controls the screen)
// Passing only CS, DC and RST makes the library use the hardware SPI peripheral
// (passing all six pins would make it bit-bang the data in software, which is much slower)
Adafruit_ILI9341 screen = Adafruit_ILI9341(CS, DC, RST);

// Last time the screen was redrawn
unsigned long lastDisplay = 0;

//****************************************************************************************************************
// TURN SIGNALS: pins, settings and state
//****************************************************************************************************************

// LED pins
#define LEFT_PIN  6
#define RIGHT_PIN 7

// Blink timing: on for BLINK_MS, then off for BLINK_MS
#define BLINK_MS 500

// Fake input: changes the signal every FAKE_INPUT_MS (temporary, until the real button or switch is chosen)
#define FAKE_INPUT_MS 5000

// Which signal the rider wants
enum SignalState { SIGNAL_OFF, SIGNAL_LEFT, SIGNAL_RIGHT };
SignalState signalState = SIGNAL_OFF;
SignalState lastState = SIGNAL_OFF; 

// Whether the active LED is lit in the current half of the blink
bool blinkOn = false;

// Last time each turn signal task ran
unsigned long lastBlink = 0;
unsigned long lastFakeInput = 0;

//****************************************************************************************************************
// SETUP AND LOOP
//****************************************************************************************************************

void setup() {
  Serial.begin(9600);

  // Display: route the hardware SPI peripheral to our pins (clock, MISO, MOSI, chip select)
  SPI.begin(CLK, MISO, MOSI, CS);

  // Display: reset the screen, send its startup commands, and set the SPI clock speed
  screen.begin(SPI_FREQ);

  // Display: start from a clean black background
  screen.fillScreen(ILI9341_BLACK);

  // Turn signals: set up the LED pins
  setupSignals();
}

void loop() {

  // Turn signals: read the input, then update the blinking (runs every loop, never blocked)
  updateSignalInput();
  updateSignalBlink();

  // Display: redraw every DISPLAY_MS, using millis() instead of delay() so the turn signals keep running
  if (millis() - lastDisplay >= DISPLAY_MS) {
    lastDisplay = millis();
    drawBattery(67);  // hard-coded for now, will come from the motor controller
    drawSpeed(52);    // hard-coded for now, will come from the motor controller
    drawLevel(4);     // hard-coded for now, will come from the PA button
  }

}

//****************************************************************************************************************
// DISPLAY: drawing functions
//****************************************************************************************************************

void drawBattery(uint8_t percentage) {
  int16_t batteryWidth = 40;
  int16_t batteryHeight = 16;
  int16_t batteryX = 10; // Position from the left edge
  int16_t batteryY = 8;  // Position from the top edge

  // Calculate the width of the battery's fill
  int16_t fillWidth = (batteryWidth - 4) * percentage / 100;

  // battery outline
  screen.drawRect(batteryX, batteryY, batteryWidth, batteryHeight, ILI9341_WHITE);
  screen.fillRect(batteryX + batteryWidth, batteryY + 3, 2, batteryHeight - 6, ILI9341_WHITE);

  // battery fill
  screen.fillRect(batteryX + 2, batteryY + 2, fillWidth, batteryHeight - 4, ILI9341_WHITE);

  // battery percent
  screen.setTextSize(2);
  screen.setTextColor(ILI9341_WHITE);
  screen.setCursor(batteryX + batteryWidth + 6, batteryY + 1);
  screen.print(percentage);
  screen.print('%');
}

// Draw speed in KM/H
void drawSpeed(uint8_t speed) {
  screen.setTextSize(2);
  screen.setTextColor(ILI9341_WHITE);
  screen.setCursor(10, 40);
  screen.println(speed);

  screen.setTextSize(2);
  screen.setTextColor(ILI9341_WHITE);
  screen.setCursor(40, 40);
  screen.println(F("KM/H"));
}

// Draw Pedal Assist (PA) level, e.g. 'PA 5'
void drawLevel(uint8_t level) {
  screen.setTextSize(2);
  screen.setTextColor(ILI9341_WHITE);
  screen.setCursor(100, 10);
  screen.println(F("PA"));

  screen.setTextSize(2);
  screen.setTextColor(ILI9341_WHITE);
  screen.setCursor(105, 40);
  screen.println(level);
}

// Screen test from the Adafruit example: draws sample text and returns how long it took in microseconds.
// Not called anywhere. Kept for testing the screen.
unsigned long testText() {

  // fill the screen with a colour
  screen.fillScreen(ILI9341_BLUE);

  // record start time (used for seeing how long the function takes to complete)
  unsigned long start = micros();

  screen.setCursor(0, 0);
  screen.setTextColor(ILI9341_WHITE);  screen.setTextSize(1);
  screen.println("Hello World!");
  screen.setTextColor(ILI9341_YELLOW); screen.setTextSize(2);
  screen.println(1234.56);
  screen.setTextColor(ILI9341_RED);    screen.setTextSize(3);
  screen.println(0xDEADBEEF, HEX);
  screen.println();
  screen.setTextColor(ILI9341_GREEN);
  screen.setTextSize(5);
  screen.println("Groop");
  screen.setTextSize(2);
  screen.println("I implore thee,");
  screen.setTextSize(1);
  screen.println("my foonting turlingdromes.");
  screen.println("And hooptiously drangle me");
  screen.println("with crinkly bindlewurdles,");
  screen.println("Or I will rend thee");
  screen.println("in the gobberwarts");
  screen.println("with my blurglecruncheon,");
  screen.println("see if I don't!");

  // return the duration of the command
  return micros() - start;
}

//****************************************************************************************************************
// TURN SIGNALS: LED output
// The only part that changes if we switch from simple LEDs to an LED strip
//****************************************************************************************************************

// Set both LED pins as outputs and start with both LEDs off
void setupSignals() {
  pinMode(LEFT_PIN, OUTPUT);
  pinMode(RIGHT_PIN, OUTPUT);
  digitalWrite(LEFT_PIN, LOW);
  digitalWrite(RIGHT_PIN, LOW);
}

// Turn the left LED on or off
void setLeftSignal(bool on) {
  digitalWrite(LEFT_PIN, on ? HIGH : LOW);
}

// Turn the right LED on or off
void setRightSignal(bool on) {
  digitalWrite(RIGHT_PIN, on ? HIGH : LOW);
}

//****************************************************************************************************************
// TURN SIGNALS: blink
//****************************************************************************************************************

// Every BLINK_MS, flip the active LED on or off. The inactive LED always stays off.
void updateSignalBlink() {
  // New state? Restart the blink so the new side lights immediately with a full first flash
  if (signalState != lastState) {
    lastState = signalState;
    blinkOn = true;
    lastBlink = millis();
    setLeftSignal(signalState == SIGNAL_LEFT);
    setRightSignal(signalState == SIGNAL_RIGHT);
    return;
  }

  if (millis() - lastBlink >= BLINK_MS) {
    lastBlink = millis();
    blinkOn = !blinkOn;

    setLeftSignal((signalState == SIGNAL_LEFT) && blinkOn);
    setRightSignal((signalState == SIGNAL_RIGHT) && blinkOn);
  }
}

//****************************************************************************************************************
// TURN SIGNALS: fake input
// Temporary: replace with the real button or switch once the team chooses one
//****************************************************************************************************************

// Every FAKE_INPUT_MS, cycle the signal: off -> left -> right -> off
void updateSignalInput() {
  if (millis() - lastFakeInput >= FAKE_INPUT_MS) {
    lastFakeInput = millis();

    if (signalState == SIGNAL_OFF) {
      signalState = SIGNAL_LEFT;
      Serial.println("Signal: LEFT");
    }
    else if (signalState == SIGNAL_LEFT) {
      signalState = SIGNAL_RIGHT;
      Serial.println("Signal: RIGHT");
    }
    else {
      signalState = SIGNAL_OFF;
      Serial.println("Signal: OFF");
    }

}